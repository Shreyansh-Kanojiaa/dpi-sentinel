# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# SQLite (runtime data, regenerated on startup)
*.db
*.db-journal

# Node / frontend
node_modules/
dist/
frontend/.vite/

# Witness identity keys (never commit private keys)
*.key
witness/witness.key

# Aggregator's own Ed25519 identity (backend/identity.py, local-dev default path)
aggregator.key

# Checkpoint git-anchor repo (Milestone 3) — Docker Compose keeps this in a
# named volume (never on the host tree), but CHECKPOINT_REPO_PATH could be
# pointed at a local dir during non-Docker dev; ignore it defensively so a
# nested git repo never gets picked up.
checkpoint-repo/

# Env files
.env
.env.local

# Claude Code local settings (machine-specific, not portable)
.claude/settings.local.json

# Logs
*.log

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store

# Pitch deck (kept locally, not in the repo)
*.pptx
.~lock.*#
